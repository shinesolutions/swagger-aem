"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server TruststoreItems"
package     = openapi_server
version     = "1.0"
description = "Defines a TruststoreItems"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  TruststoreItems {
    title = TruststoreItems
    description = TruststoreItems
    derivedFrom = Root
    properties {
        alias {
          type =  string
          description = "Truststore alias name"
          optional = false
        }
        entry_type {
          type =  string
          description = ""
          optional = false
        }
        subject {
          type =  string
          description = "e.g. \&quot;CN&#x3D;localhost\&quot;"
          optional = false
        }
        issuer {
          type =  string
          description = "e.g. \&quot;CN&#x3D;Admin\&quot;"
          optional = false
        }
        not_before {
          type =  string
          description = "e.g. \&quot;Sun Jul 01 12:00:00 AEST 2018\&quot;"
          optional = false
        }
        not_after {
          type =  string
          description = "e.g. \&quot;Sun Jun 30 23:59:50 AEST 2019\&quot;"
          optional = false
        }
        serial_number {
          type =  integer
          description = "18165099476682912368"
          optional = false
        }
    }
  }
}

serviceTemplates {

  TruststoreItems {
    title = TruststoreItems
    description = TruststoreItems
    implements = openapi_server.resourceTypes.TruststoreItems

  }
}
