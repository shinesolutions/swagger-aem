"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server KeystoreItems"
package     = openapi_server
version     = "1.0"
description = "Defines a KeystoreItems"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  KeystoreChainItems = openapi_server.resourceTypes.KeystoreChainItems
}
resourceTypes {

  KeystoreItems {
    title = KeystoreItems
    description = KeystoreItems
    derivedFrom = Root
    properties {
        alias {
          type =  string
          description = "Keystore alias name"
          optional = false
        }
        entry_type {
          type =  string
          description = "e.g. \&quot;privateKey\&quot;"
          optional = false
        }
        algorithm {
          type =  string
          description = "e.g. \&quot;RSA\&quot;"
          optional = false
        }
        format {
          type =  string
          description = "e.g. \&quot;PKCS#8\&quot;"
          optional = false
        }
        chain {
          type = array
          items.type = KeystoreChainItems
          description = ""
          optional = false
        }
    }
  }
}

serviceTemplates {

  KeystoreItems {
    title = KeystoreItems
    description = KeystoreItems
    implements = openapi_server.resourceTypes.KeystoreItems

  }
}
