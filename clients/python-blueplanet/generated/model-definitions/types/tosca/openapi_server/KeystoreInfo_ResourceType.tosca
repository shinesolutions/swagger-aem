"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server KeystoreInfo"
package     = openapi_server
version     = "1.0"
description = "Defines a KeystoreInfo"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  KeystoreItems = openapi_server.resourceTypes.KeystoreItems
}
resourceTypes {

  KeystoreInfo {
    title = KeystoreInfo
    description = KeystoreInfo
    derivedFrom = Root
    properties {
        aliases {
          type = array
          items.type = KeystoreItems
          description = ""
          optional = false
        }
        exists {
          type =  boolean
          description = "False if truststore don&#39;t exist"
          optional = false
        }
    }
  }
}

serviceTemplates {

  KeystoreInfo {
    title = KeystoreInfo
    description = KeystoreInfo
    implements = openapi_server.resourceTypes.KeystoreInfo

  }
}
