<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Description>OpenAPI</Description>
    <Copyright>OpenAPI</Copyright>
    <TargetFramework>netcoreapp2.1</TargetFramework>
    <AzureFunctionsVersion>v2</AzureFunctionsVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Sdk.Functions" Version="1.0.24" />
    <PackageReference Include="Newtonsoft.Json" Version="12.0.1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="host.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="local.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src/model/TruststoreItems.fs" />
    <Compile Include="src/model/TruststoreInfo.fs" />
    <Compile Include="src/model/SamlConfigurationPropertyItemsString.fs" />
    <Compile Include="src/model/SamlConfigurationPropertyItemsLong.fs" />
    <Compile Include="src/model/SamlConfigurationPropertyItemsBoolean.fs" />
    <Compile Include="src/model/SamlConfigurationPropertyItemsArray.fs" />
    <Compile Include="src/model/SamlConfigurationProperties.fs" />
    <Compile Include="src/model/SamlConfigurationInfo.fs" />
    <Compile Include="src/model/KeystoreChainItems.fs" />
    <Compile Include="src/model/KeystoreItems.fs" />
    <Compile Include="src/model/KeystoreInfo.fs" />
    <Compile Include="src/model/InstallStatusStatus.fs" />
    <Compile Include="src/model/InstallStatus.fs" />
    <Compile Include="src/model/BundleDataProp.fs" />
    <Compile Include="src/model/BundleData.fs" />
    <Compile Include="src/model/BundleInfo.fs" />
    <Compile Include="src/api/ConsoleApiHandlerParams.fs" />
    <Compile Include="src/api/ConsoleApiServiceInterface.fs" />
    <Compile Include="src/impl/ConsoleApiService.fs" />
    <Compile Include="src/api/ConsoleApiHandler.fs" />
    <Compile Include="src/api/CqApiHandlerParams.fs" />
    <Compile Include="src/api/CqApiServiceInterface.fs" />
    <Compile Include="src/impl/CqApiService.fs" />
    <Compile Include="src/api/CqApiHandler.fs" />
    <Compile Include="src/api/CrxApiHandlerParams.fs" />
    <Compile Include="src/api/CrxApiServiceInterface.fs" />
    <Compile Include="src/impl/CrxApiService.fs" />
    <Compile Include="src/api/CrxApiHandler.fs" />
    <Compile Include="src/api/CustomApiHandlerParams.fs" />
    <Compile Include="src/api/CustomApiServiceInterface.fs" />
    <Compile Include="src/impl/CustomApiService.fs" />
    <Compile Include="src/api/CustomApiHandler.fs" />
    <Compile Include="src/api/GraniteApiHandlerParams.fs" />
    <Compile Include="src/api/GraniteApiServiceInterface.fs" />
    <Compile Include="src/impl/GraniteApiService.fs" />
    <Compile Include="src/api/GraniteApiHandler.fs" />
    <Compile Include="src/api/SlingApiHandlerParams.fs" />
    <Compile Include="src/api/SlingApiServiceInterface.fs" />
    <Compile Include="src/impl/SlingApiService.fs" />
    <Compile Include="src/api/SlingApiHandler.fs" />
  </ItemGroup>

</Project>