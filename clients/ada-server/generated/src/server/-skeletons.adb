         Remove_Alias := To_Swagger.UString (Swagger.Servers.Get_Query_Parameter (Req, "removeAlias"));

         
         Intermediate_Path := To_Swagger.UString (Swagger.Servers.Get_Path_Parameter (Req, 1));

         Authorizable_Id := To_Swagger.UString (Swagger.Servers.Get_Path_Parameter (Req, 2));

         Swagger.Servers.Get_Parameter (Context, "cert-chain", Cert_Chain);
         Swagger.Servers.Get_Parameter (Context, "pk", Pk);
         Swagger.Servers.Get_Parameter (Context, "keyStore", Key_Store);
         Server.Post_Authorizable_Keystore
